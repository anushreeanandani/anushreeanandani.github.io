---
import Button from "../../common/Button.astro";
import { Icon } from "astro-icon/components";

const contactUrl = "/contact";
---

<h2 slot="title" class="about-title scroll-target-title">Keep in touch</h2>

<div class="about-content scroll-target-content">
  <p>
    I am interested in talking about memory, neurodegenerative disorders and sustainability.
    I am currently looking for internship roles in Summer 2026 that involve data analysis,
     research, consultancy and health. 
  </p>
  <p>
    Below are some ways that you can contact me. The best way to get in touch
    is sending an email. Always looking to connect :) 
  </p>

  <div class="connect-icon-links">
    <a
      href="mailto:aa11093@nyu.edu"
      title="Send me an email"
      aria-label="Email"
    >
      <Icon name="ri:mail-line" size={24} aria-hidden="true" />
    </a>
    <a
      href="https://github.com/anushreeanandani"
      target="_blank"
      rel="noopener noreferrer"
      title="View my GitHub profile"
      aria-label="GitHub"
    >
      <Icon name="ri:github-line" size={22} aria-hidden="true" />
    </a>
    <a
      href="https://linkedin.com/in/anushree-anandani"
      target="_blank"
      rel="noopener noreferrer"
      title="View my LinkedIn profile"
      aria-label="LinkedIn"
    >
      <Icon name="ri:linkedin-box-line" size={22} aria-hidden="true" />
    </a>
  </div>

  <div class="button-group">
    <Button
      class="button"
      href={contactUrl}
      text="See All Contact Info"
      wrapperClass="cta-link"
    />
  </div>
</div>

<style>
  p {
    margin-bottom: 1.5rem;
    line-height: 1.7;
    color: var(--theme-text);
  }

  .connect-icon-links {
    display: flex;
    align-items: center;
    gap: 1.8rem;
    margin-bottom: 2.5rem;
  }

  .connect-icon-links a {
    color: var(--theme-icon-color);
    opacity: 0.8;
    transition:
      opacity 0.2s ease,
      color 0.2s ease;
    display: inline-block;
  }

  .connect-icon-links a:hover,
  .connect-icon-links a:focus {
    opacity: 1;
    outline: none;
  }

  .button-group {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
