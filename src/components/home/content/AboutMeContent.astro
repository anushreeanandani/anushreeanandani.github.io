---
// Content for the "Meet me!" section
import Button from "../../common/Button.astro";

const resumeUrl = "/resume";
// const contactUrl = "/contact";
---

<h2 slot="title" class="about-title scroll-target-title">About me</h2>

<div class="about-content scroll-target-content">
  <p>
    I am driven by a deep curiosity about human behavior. I’ve always been 
    fascinated by questions like why do we think, learn, and make choices the way we do? 
  </p>

  <p>
    I am interested in learning about the physiological and neural basis of decision-making
    and how it relates to our environment and relationships with others. I am currently a
    Research Assistant in Neuroscience of Multilingualism Lab. 

  </p>

  <div class="button-group">
    <Button
      class="button"
      href={resumeUrl}
      text="View My Résumé"
      wrapperClass="meet-me-cta-button"
    />
  </div>
</div>

<style>
  .button-group {
    display: flex;
    gap: 1rem; /* Adjust spacing as needed */
    margin-top: 2rem;
  }
</style>
